# Never commit real secrets.
HELIUS_API_KEY=
HELIUS_WEBHOOK_AUTH_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USERNAME=PelleSuper
CRON_SECRET=
RADAR_ADMIN_SECRET=

# Solana Tracker Data API (not its RPC key). Server-side only.
SOLANA_TRACKER_API_KEY=

# GMGN OpenAPI with Enable Reading. Used for security, wallet classifications,
# token balances, first funding origins and wallet creation times.
GMGN_API_KEY=

# Specialist common-funder/fresh-wallet evidence. Until complete, fresh,
# mint-matched evidence is available, ALL positive alerts are blocked.
# Solana Tracker insider data does not satisfy the common-funder check.
# GMGN can supply these checks when the full holder coverage and fields exist.
WALLET_RISK_API_URL=
WALLET_RISK_API_KEY=

# Comma-separated pair mints from fresh official announcements. First-mover
# inference still works without this manual/event-feed override.
RECENT_PAIR_MINTS=
DISCOVERY_MAX_STARTS=25

# Official public Stonk API. Override only if its base URL changes.
STONKFUN_API_BASE=https://www.stonkfun.xyz/api/public/v1

# Optional official X read API. Configure the verified numeric ID of Stonk's
# official account, not your own account. Without both, X is NOT active.
X_BEARER_TOKEN=
X_STONK_USER_ID=
